<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Nota: modelVersion 4.0.0 é o schema XML padrão exigido pelo Apache Maven (compatível com Maven 3.x e 4.1.2+). -->
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.rpg</groupId>
    <artifactId>rpg-console-solid</artifactId>
    <version>4.1.2</version>
    <packaging>jar</packaging>

    <name>Crônicas do Abismo - RPG Console (POO &amp; SOLID)</name>
    <description>RPG em modo console desenvolvido em Java 17 com Maven 4.1.2 aplicando POO, SOLID, Sorte (Luck), Esquiva, Eventos Aleatórios e Progressão Persistente.</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Versões das dependências e plugins -->
        <gson.version>2.11.0</gson.version>
        <jansi.version>2.4.1</jansi.version>
        <junit.version>5.11.3</junit.version>
    </properties>

    <dependencies>
        <!-- Serialização JSON para sistema de Save/Load e progressão contínua do jogador -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- Suporte multiplataforma a cores ANSI no terminal (barras de vida, críticos, esquivas e raridades) -->
        <dependency>
            <groupId>org.fusesource.jansi</groupId>
            <artifactId>jansi</artifactId>
            <version>${jansi.version}</version>
        </dependency>

        <!-- JUnit 5 para testes unitários das regras de combate, sorte, esquiva e contratos SOLID -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>rpg-console-solid-${project.version}</finalName>
        <plugins>
            <!-- 1. Compilador configurado rigorosamente para Java 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>

            <!-- 2. Execução interativa direta via terminal com 'mvn exec:java' -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>br.com.rpg.Main</mainClass>
                    <cleanupDaemonThreads>false</cleanupDaemonThreads>
                </configuration>
            </plugin>

            <!-- 3. Empacotamento Fat-JAR executável com todas as dependências ('java -jar target/rpg-console-solid-4.1.2.jar') -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>br.com.rpg.Main</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 4. Execução automatizada da suíte de testes JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>

            <!-- 5. Relatório de cobertura de testes (JaCoCo) para validação das mecânicas do RPG -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
